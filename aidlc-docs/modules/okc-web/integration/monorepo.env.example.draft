# =============================================================================
# DRAFT — 병합 시 이 파일을 <monorepo-root>/.env.example 로 옮겨라.
# (현재 위치 aidlc-docs/integration/ 는 모노레포 루트가 아직 없어서의 임시 보관용.)
#
# 규칙:
#   - 이 파일은 "이름만" 담는다. 실제 값은 절대 여기에 쓰지 않는다.
#   - 사용 시: cp .env.example .env  후 .env 에만 값을 채운다. .env 는 커밋 금지(.gitignore).
#   - provider 자격증명은 env-var "이름"으로만 참조(A-2, 시크릿 위생 C6).
#   - 아래 provider/경로 이름 중 (확인필요) 표시는 okc-core 실제 설정 키에 맞춰 확정할 것.
# =============================================================================

# --- LLM / AI provider (okc-core AI 파이프라인용) --- (확인필요: okc-core 설정 기준)
# okc-core가 인제스트·합성·critic 단계에서 사용하는 provider 자격증명. 실제 키 이름은 okc-core config에 맞춰라.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 또는 okc-core가 요구하는 provider 키 이름으로 대체. remote provider 사용은 okc-web에서 disclosure/consent 후에만 호출됨.

# --- okc-core 링크/핀 ---
# okc-core를 서브모듈/vendored로 편입한 경로 및 핀 커밋(문서용; 빌드 설정과 일치시켜라).
# okc-web 백엔드는 이 경로의 bindings/python 에서 `okc-compiler`(okc Python 바인딩)를 maturin으로 빌드해 import 한다(빌드타임 Rust 툴체인 필요).
OKC_CORE_PATH=./okc-core
OKC_CORE_PINNED_COMMIT=            # U0 착수 시 확정

# --- okc-web 백엔드 (FastAPI/uvicorn, 단일 워커) ---
OKC_WEB_BIND_HOST=127.0.0.1
OKC_WEB_BIND_PORT=8080
OKC_WEB_PUBLIC_BASE_URL=http://127.0.0.1:8080   # 업로드 토큰 URL(/u/{token}/upload) 조립에 사용
OKC_WEB_STATE_DB_PATH=./data/okc-web.sqlite      # 단일 SQLite(WAL) 상태 파일
OKC_WEB_SOURCES_ROOT=./data/sources              # 업로드 착지 루트(절대경로화됨)
OKC_WEB_COMPILE_OUTPUT_ROOT=./data/compiled      # 병합 Vault(knowledge/·legacy/·.okc/) 출력 루트
OKC_WEB_SESSION_COOKIE_SECRET=                   # 세션 쿠키 서명 시크릿(이름만; 값은 .env)
OKC_WEB_UPLOAD_MAX_BYTES=                         # 업로드 하드 바이트 상한(예: 정수 바이트)
OKC_WEB_LOG=info                                  # stdlib logging 레벨(관측 C6)

# --- okc-web 프론트엔드 (React + Vite) ---
VITE_API_BASE_URL=http://127.0.0.1:8080          # 프론트가 호출할 백엔드 API 베이스(Vite: import.meta.env.VITE_*)

# --- okc-mcp (서빙 계약 소비자; 미구현) --- (선택)
# OKC_MCP_SERVING_BASE_URL=                       # okc-web 읽기전용 /api/serving/* 소비 위치

# --- obsidian-hook (업로드 계약 생산자; 미구현) --- (선택, 플러그인 설정 측)
# OKC_WEB_UPLOAD_TOKEN=                           # admin이 okc-web에서 발급한 업로드 토큰(플러그인 설정에 저장; 저장소엔 커밋 금지)
